import MainLayout from '../layouts/MainLayout.astro';
---
<MainLayout title="Sobre a Code Shield" description="Conheça a abordagem da Code Shield para design, desenvolvimento e qualidade de software.">
  <section class="page-hero"><div class="wrap"><div class="breadcrumb"><a href="/">Início</a><span>/</span><span>Sobre</span></div><span class="eyebrow"><span class="dot"></span> CODE SHIELD</span><h1>Curiosidade técnica.<br /><span class="gradient-text">Compromisso com a entrega.</span></h1><p>Somos uma operação de tecnologia que acredita na combinação de boas interfaces, código organizado e soluções que resolvem necessidades reais. Cada projeto começa com uma conversa clara sobre objetivos e limites.</p><a class="btn btn-primary" href="/contato/">Vamos conversar <span aria-hidden="true">↗</span></a></div></section>
  <section class="section wrap"><div class="studio-panel"><div class="studio-art"><img src="/images/branding/selo-code-shield.webp" width="550" height="550" alt="Emblema circular da Code Shield em verde neon" class="studio-emblem" /></div><div><span class="section-label">NOSSO JEITO DE FAZER</span><h2>Mais do que um visual futurista.<br /><span class="gradient-text">Uma experiência bem resolvida.</span></h2><p>Usamos tecnologia para criar experiências digitais que sejam fáceis de entender, agradáveis de usar e sustentáveis de manter. Da ideia inicial aos testes, valorizamos cada detalhe.</p><div class="studio-points"><span>// clareza</span><span>// design</span><span>// qualidade</span><span>// evolução</span></div><img src="/images/branding/logo-original.webp" width="421" height="109" alt="Logotipo original da Code Shield" loading="lazy" class="studio-wordmark" /></div></div></section>
</MainLayout>
