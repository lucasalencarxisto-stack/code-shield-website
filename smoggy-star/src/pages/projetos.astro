---
import MainLayout from '../layouts/MainLayout.astro';
import PortfolioSection from '../components/home/PortfolioSection.astro';
---
<MainLayout title="Projetos | Code Shield" description="Conheça NutriWarrior, DeepBruce AI e Python no Bolso, projetos autorais e experimentos da Code Shield.">
  <section class="page-hero">
    <div class="wrap">
      <div class="breadcrumb"><a href="/">Início</a><span>/</span><span>Projetos</span></div>
      <span class="eyebrow"><span class="dot"></span> NOSSO LABORATÓRIO</span>
      <h1>Ideias que ganham <span class="gradient-text">vida em código.</span></h1>
      <p>Conheça nossos produtos autorais e experimentos em engenharia digital.</p>
    </div>
  </section>
  <PortfolioSection />
</MainLayout>
