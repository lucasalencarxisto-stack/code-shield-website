<div class="matrix-background" aria-hidden="true">
  <video data-motion-video data-matrix-video muted loop playsinline preload="none" poster="/videos/matrix-poster.jpg">
    <source data-src="/videos/background-ocean.mp4" type="video/mp4" />
  </video>
</div>

<script>
  // Sources are attached only when motion is allowed, including brand and orbit videos.
  const preference = window.matchMedia('(prefers-reduced-motion: reduce)');
  const videos = document.querySelectorAll<HTMLVideoElement>('[data-motion-video]');
  function syncMotion() {
    videos.forEach((video) => {
      if (preference.matches) {
        video.autoplay = false;
        video.pause();
        video.querySelectorAll('source').forEach((source) => source.removeAttribute('src'));
        video.load();
      } else {
        video.autoplay = true;
        video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
          if (!source.hasAttribute('src') && source.dataset.src) source.src = source.dataset.src;
        });
        video.load();
        video.play().catch(() => { /* The poster remains visible if autoplay is unavailable. */ });
      }
    });
  }
  syncMotion();
  preference.addEventListener('change', syncMotion);
</script>

<style>
  .matrix-background {
    position: fixed;
    inset: 0;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--black);
  }
  .matrix-background::before { content: ''; display: none; position: absolute; inset: 0; background: url('/videos/matrix-poster.jpg') center / cover no-repeat; }
  video { position: relative; display: block; width: 100%; height: 100%; object-fit: cover; }
  @media (prefers-reduced-motion: reduce) {
    video { visibility: hidden; }
    .matrix-background::before { display: block; }
  }
</style>
