---
interface Props { slug: string; }
const { slug } = Astro.props;
---
<div class="service-icon" aria-hidden="true">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    {slug === 'websites' && <g><rect x="2.5" y="4.5" width="19" height="15" rx="2"/><path d="M2.5 9h19M6.8 7h.1M10 7h.1"/></g>}
    {slug === 'qa-testing' && <g><path d="m9 12 2 2 4-4"/><path d="M12 3 4 7v5c0 5 3.5 7.7 8 9 4.5-1.3 8-4 8-9V7z"/></g>}
    {slug === 'ciberseguranca' && <g><path d="M12 3 4 7v5c0 5 3.5 7.7 8 9 4.5-1.3 8-4 8-9V7z"/><rect x="9" y="11" width="6" height="5" rx="1"/><path d="M10 11V9.8a2 2 0 0 1 4 0V11"/></g>}
    {slug === 'software' && <g><path d="m8 8-4 4 4 4m8-8 4 4-4 4M14 5l-4 14"/></g>}
    {slug === 'inteligencia-artificial' && <g><path d="M12 6c-1-2-4-2-5 0-3 0-4 3-2.5 5-.9 2 .6 4.5 3 4.6C8 18 11 19 12 17"/><path d="M12 6c1-2 4-2 5 0 3 0 4 3 2.5 5 .9 2-.6 4.5-3 4.6-.5 2.4-3.5 3.4-4.5 1.4V6M9 9v3m6-3v3m-6 0 3 2 3-2"/></g>}
    {slug === 'aplicativos' && <g><rect x="7" y="2.5" width="10" height="19" rx="2.3"/><path d="M10 18.5h4M10 5h4"/></g>}
  </svg>
</div>
